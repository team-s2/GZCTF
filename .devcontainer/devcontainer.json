// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet-postgres
{
    "name": "ZJUCTF",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "containerEnv": {
        // persist configs under workspace
        "OPENCODE_CONFIG_DIR": "${containerWorkspaceFolder}/.opencode",
        "CODEX_HOME": "${containerWorkspaceFolder}/.codex"
    },
    // Features to add to the dev container. More info: https://containers.dev/features.
    "features": {
        "ghcr.io/devcontainers/features/node:2": {},
        "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {},
        "ghcr.io/devcontainers/features/kubectl-helm-minikube": {}
    },
    "postStartCommand": "npm config set registry https://registry.npmmirror.com"
}